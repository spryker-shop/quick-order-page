{% extends model('template') %}

{% define data = {
    price: _view.price,
    additionalColumns: _view.additionalColumns,
    product: _view.product,
    messages: _view.messages,
    form: _view.form,
    index: _view.index | default(0),
} %}

{% block template %}
    {% embed molecule('quick-order-row-partial', 'QuickOrderPage') with {
        data: {
            quantityField: data.form ? data.form.quantity : null,
            customQuantityFieldName: 'quick_order_form[items][' ~ data.index ~ '][quantity]',
            price: data.price,
            additionalColumns: data.additionalColumns,
            messages: data.messages,
            product: data.product,
            form: data.form,
            customFieldNamePattern: 'quick_order_form[items][' ~ data.index ~ '][%name%]',
        },
    } only %}
        {% block component %}
            {{ block('body') }}
        {% endblock %}
    {% endembed %}

    {# The row's product carries no category path: the traceable events add it to the row's tracking details from here. #}
    {% block productTrackingDetails %}
        {% if data.product %}
            {% widget 'ProductTrackingDetailsWidget' args [[{
                id_product_abstract: data.product.fkProductAbstract,
                abstract_sku: data.product.abstractSku,
            }]] only %}{% endwidget %}
        {% endif %}
    {% endblock %}
{% endblock %}
