<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="QuickOrder">
        <property name="items" type="QuickOrderItem[]" singular="items"/>
    </transfer>

    <transfer name="QuickOrderItem">
        <property name="sku" type="string"/>
        <property name="quantity" type="int"/>
        <property name="sumPrice" type="int"/>
        <property name="productConcrete" type="ProductConcrete"/>
        <property name="messages" type="Message[]" singular="message"/>
    </transfer>

    <transfer name="ProductView">
        <property name="idProductAbstract" type="int"/>
        <property name="idProductConcrete" type="int"/>
        <property name="attributes" type="array" singular="attributes"/>
        <property name="abstractSku" type="string"/>
        <property name="abstractName" type="string" description="The name of the abstract product."/>
        <property name="brand" type="string" description="Brand of the product, the value of its brand attribute; null when it has none."/>
        <property name="selectedVariantAttributes" type="array" singular="selectedVariantAttribute" description="The super attributes of the concrete product the view shows, attribute key to value, ordered by attribute key as strings, e.g. {&quot;color&quot;: &quot;Red&quot;, &quot;storage_capacity&quot;: &quot;64 GB&quot;}; empty without a concrete product."/>
        <property name="categoryPath" type="string[]" singular="categoryName" description="The category names of the product, top level first, without the root category."/>
    </transfer>

    <transfer name="ProductConcrete">
        <property name="fkProductAbstract" type="int"/>
        <property name="sku" type="string"/>
        <property name="idProductConcrete" type="int"/>
        <property name="localizedAttributes" type="LocalizedAttributes[]" singular="localizedAttributes"/>
        <property name="defaultPrice" type="string"/>
        <property name="prices" type="PriceProduct[]" singular="price"/>
        <property name="attributes" type="array" singular="attribute"/>
        <property name="abstractSku" type="string"/>
        <property name="abstractName" type="string" description="The name of the abstract product in the current locale."/>
        <property name="brand" type="string" description="Brand of the product, the value of its brand attribute; null when it has none."/>
        <property name="selectedVariantAttributes" type="array" singular="selectedVariantAttribute" description="The super attributes of the concrete product the view shows, attribute key to value, ordered by attribute key as strings, e.g. {&quot;color&quot;: &quot;Red&quot;, &quot;storage_capacity&quot;: &quot;64 GB&quot;}; empty without a concrete product."/>
        <property name="categoryPath" type="string[]" singular="categoryName" description="The category names of the product, top level first, without the root category."/>
    </transfer>

    <transfer name="PriceProduct">
    </transfer>

    <transfer name="Message">
        <property name="type" type="string"/>
        <property name="value" type="string"/>
        <property name="parameters" type="array" singular="parameters"/>
    </transfer>

    <transfer name="CurrentProductPrice">
        <property name="sumPrice" type="int"/>
        <property name="price" type="int"/>
        <property name="prices" type="array" singular="price"/>
    </transfer>

    <transfer name="Item">
        <property name="productConcrete" type="ProductConcrete"/>
        <property name="groupKeyPrefix" type="string"/>
        <property name="sku" type="string"/>
        <property name="idProductAbstract" type="int"/>
        <property name="quantity" type="int"/>
    </transfer>

    <transfer name="QuickOrderFormProcessResponse">
        <property name="route" type="Route"/>
    </transfer>

    <transfer name="PriceProductFilter">
        <property name="quantity" type="int"/>
        <property name="idProduct" type="int"/>
        <property name="idProductAbstract" type="int"/>
        <property name="sku" type="string"/>
        <property name="priceProductResolveConditions" type="PriceProductResolveConditions" strict="true"/>
    </transfer>

    <transfer name="PriceProductResolveConditions" strict="true">
        <property name="sku" type="string"/>
    </transfer>

    <transfer name="ProductConcreteStorage">
        <property name="idProductAbstract" type="int"/>
    </transfer>

    <transfer name="LocalizedAttributes">
        <property name="name" type="string"/>
    </transfer>

    <transfer name="Route">
        <property name="parameters" type="array" singular="parameters"/>
        <property name="route" type="string"/>
    </transfer>

    <transfer name="CsvFile">
    </transfer>

    <transfer name="Quote">
    </transfer>

</transfers>
